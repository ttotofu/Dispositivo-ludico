  }
}

void actualizarColor()
{
  if (!sensorOK) return;

  uint16_t r, g, b, c;
  tcs.getRawData(&r, &g, &b, &c);

  if (c == 0) {
    colorValido = false;
    strcpy(colorActual, "SIN LUZ");
    muestraActual = COLOR_NEGRO;
    mostrarResultadoColor(muestraActual, colorActual);
    return;
  }

  int rojo  = constrain((r * 255L) / c, 0, 255);
  int verde = constrain((g * 255L) / c, 0, 255);
  int azul  = constrain((b * 255L) / c, 0, 255);

  const char *nombre = detectarColor(rojo, verde, azul);
  strncpy(colorActual, nombre, sizeof(colorActual) - 1);
  colorActual[sizeof(colorActual) - 1] = '\0';
  muestraActual = gfx->color565(rojo, verde, azul);
  colorValido = (indiceColor(colorActual) >= 0);

  mostrarResultadoColor(muestraActual, colorActual);
}

void capturarColor()
{
  if (!sensorOK || !colorValido) {
    gfx->fillRect(0, 180, 240, 60, COLOR_NEGRO);
    textoCentrado("SIN COLOR", 186, 2, COLOR_ROJO);
    delay(350);
    mostrarResultadoColor(muestraActual, colorActual);
    return;
  }

  int idx = indiceColor(colorActual);
  if (idx < 0) return;

  // Modo ADIVINA: solo cuenta si el color capturado es el de la adivinanza
  if (modoJuego == MODO_ADIVINA && idx != adivinanzaColor) {
    gfx->fillRect(0, 180, 240, 60, COLOR_NEGRO);
    textoCentrado("NO ES ESE", 186, 2, COLOR_ROJO);
    textoCentrado("SIGUE BUSCANDO", 208, 1, COLOR_BLANCO);
    delay(800);
    mostrarResultadoColor(muestraActual, colorActual);
    return;
  }

  conteosColores[idx]++;
  totalCapturas++;
  guardarArchivo();

  if (modoJuego == MODO_ADIVINA) {
    gfx->fillRect(0, 180, 240, 60, COLOR_NEGRO);
    textoCentrado("CORRECTO!", 186, 2, COLOR_VERDE);
    textoCentrado(colorActual, 208, 1, COLOR_BLANCO);
    delay(1000);
    elegirAdivinanza();      // siguiente adivinanza
    dibujarAdivinanza();
    return;
  }

  mostrarResultadoColor(muestraActual, colorActual);
}

bool pulsacionNueva(uint8_t indice)
{
  EstadoBoton &b = botones[indice];
  bool lectura = digitalRead(b.pin);

  if (lectura != b.lecturaAnterior) {
    b.lecturaAnterior = lectura;
    b.cambio = millis();
  }

  if (millis() - b.cambio >= ANTIRREBOTE_MS && lectura != b.estadoEstable) {
    b.estadoEstable = lectura;
    if (b.estadoEstable == LOW) return true;
  }
  return false;
}

void procesarBotones()
{
  // Se leen los tres siempre, para mantener el antirrebote de cada uno
  bool juego   = pulsacionNueva(0);   // boton JUEGO   = opciones A
  bool archivo = pulsacionNueva(1);   // boton ARCHIVO = opciones B
  bool captura = pulsacionNueva(2);
  bool cualquiera = juego || archivo || captura;

  switch (pantallaActual) {
    case PANTALLA_INICIO:
      if (juego || archivo) irAlMenu();
      break;

    case PANTALLA_MENU:
      if (juego) entrarAModos();             // A_JUEGO
      else if (archivo) entrarAlArchivo();   // B_ARCHIVO
      break;

    case PANTALLA_MODOS:
      if (juego) {                           // A_CAPTURA
        modoJuego = MODO_CAPTURA;
        mostrarInstruccion();
      } else if (archivo) {                  // B_ADIVINA
        modoJuego = MODO_ADIVINA;
        mostrarInstruccion();
      } else if (captura) {
        irAlMenu();
      }
      break;

    case PANTALLA_INSTRUCCION:
      if (cualquiera) {
        if (modoJuego == MODO_ADIVINA) {
          elegirAdivinanza();
          dibujarAdivinanza();
        } else {
          entrarAlJuego();
        }
      }
      break;

    case PANTALLA_ADIVINANZA:
      if (cualquiera) entrarAlJuego();
      break;

    case PANTALLA_JUEGO:
      if (juego) {
        irAlMenu();
      } else if (archivo) {
        if (modoJuego == MODO_ADIVINA) dibujarAdivinanza();   // releer la adivinanza
        else irAlMenu();
      } else if (captura) {
        capturarColor();
      }
      break;

    case PANTALLA_ARCHIVO:
      if (juego) irAlMenu();
      else if (archivo) avanzarArchivo();
      break;
  }
}

// Se inicia DESPUES de la camara: la camara configura sus pines por software
// y el sensor usa el I2C por hardware en otros pines.
void sensorColorBegin()
{
  Wire.begin(SENSOR_SDA, SENSOR_SCL);
   Wire.setClock(100000);


if (tcs.begin(0x29, &Wire))
  {
    sensorOK = true;
    Serial.println("TCS34725 OK.");
  }
  else
  {
    sensorOK = false;
    Serial.println("ERROR: TCS34725 NO detectado.");
    // El aviso "SIN SENSOR" se muestra al entrar al modo juego (entrarAlJuego).
  }
}


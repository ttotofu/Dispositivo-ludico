// LISTADO DE ARCHIVO (solo colores con conteo distinto de 0, 3 filas visibles)
// --------------------------------------------------
const uint8_t FILAS_ARCHIVO = 3;
const int ARCH_Y0    = 60;    // y de la primera fila
const int ARCH_ALTO  = 36;    // alto de cada fila
const int ARCH_PASO  = 42;    // distancia entre filas
const int ARCH_ANCHO = 180;   // ancho maximo de cada fila

uint8_t listaArchivo[TOTAL_COLORES];   // indices de NOMBRES_COLORES con conteo > 0
uint8_t totalListaArchivo = 0;
uint8_t seleccionArchivo = 0;          // posicion dentro de listaArchivo

// =====================================================
// FUNCIÓN: DETECTAR COLOR
// =====================================================

const char* detectarColor(
  int rojo,
  int verde,
  int azul
) {

  // ---------------------------------------------------
  // BUSCAR EL VALOR MÁXIMO Y MÍNIMO
  // ---------------------------------------------------

  int maximo = max(rojo, max(verde, azul));
  int minimo = min(rojo, min(verde, azul));

  int diferencia = maximo - minimo;


  // ---------------------------------------------------
  // BRILLO MUY BAJO
  // ---------------------------------------------------

  if (maximo < 25) {
    return "NEGRO";
  }


  // ---------------------------------------------------
  // GRIS
  // ---------------------------------------------------

  // Si los tres canales son parecidos
  if (diferencia < 25) {

    if (maximo < 80) {
      return "GRIS";
    }

    return "BLANCO";
  }


  // ---------------------------------------------------
  // BLANCO
  // ---------------------------------------------------

  if (minimo > 170 &&
      diferencia < 70) {

    return "BLANCO";
  }


  // ---------------------------------------------------
  // CALCULAR TONO HUE
  // ---------------------------------------------------

  float h = 0;

  if (diferencia == 0) {

    h = 0;

  } else if (maximo == rojo) {

    h = 60.0 * (
      (float)(verde - azul) / diferencia
    );

    if (h < 0) {
      h += 360;
    }

  } else if (maximo == verde) {

    h = 60.0 * (
      (float)(azul - rojo) / diferencia
    ) + 120;

  } else {

    h = 60.0 * (
      (float)(rojo - verde) / diferencia
    ) + 240;
  }


  // ---------------------------------------------------
  // SATURACIÓN
  // ---------------------------------------------------

  float saturacion =
    (float)diferencia / maximo;


  // ---------------------------------------------------
  // POCO COLOR
  // ---------------------------------------------------

  if (saturacion < 0.18) {

    if (maximo < 100) {
      return "GRIS";
    }

    return "BLANCO";
  }


  // ===================================================
  // CLASIFICACIÓN
  // ===================================================

  // ---------------------------------------------------
  // ROJO
  // 0° aproximadamente
  // ---------------------------------------------------

  if (h >= 345 || h < 10) {
    return "ROJO";
  }


  // ---------------------------------------------------
  // ROSADO
  // ---------------------------------------------------

  if (h >= 330 && h < 345) {

    if (rojo > 120) {
      return "ROSADO";
    }

    return "ROJO";
  }


  // ---------------------------------------------------
  // NARANJA
  // ---------------------------------------------------

  if (h >= 10 && h < 45) {
    return "NARANJA";
  }


  // ---------------------------------------------------
  // AMARILLO
  // ---------------------------------------------------

  if (h >= 45 && h < 75) {
    return "AMARILLO";
  }


  // ---------------------------------------------------
  // VERDE
  // ---------------------------------------------------

  if (h >= 75 && h < 165) {
    return "VERDE";
  }


  // ---------------------------------------------------
  // TURQUESA
  // ---------------------------------------------------

  if (h >= 165 && h < 195) {
    return "TURQUESA";
  }


  // ---------------------------------------------------
  // AZUL
  // ---------------------------------------------------

  if (h >= 195 && h < 255) {
    return "AZUL";
  }


  // ---------------------------------------------------
  // MORADO
  // ---------------------------------------------------

  if (h >= 255 && h < 300) {
    return "MORADO";
  }


  // ---------------------------------------------------
  // ROSADO / MAGENTA
  // ---------------------------------------------------

  if (h >= 300 && h < 345) {
    return "ROSADO";
  }


  // ---------------------------------------------------
  // SEGURIDAD
  // ---------------------------------------------------

  return "COLOR";
}


// --------------------------------------------------
// MOSTRAR RESULTADO EN LAS BANDAS LIBRES DE LA PANTALLA
// --------------------------------------------------
// El video ocupa y = 60 a 179. Arriba (y 0-59) va la muestra de color
// y abajo (y 180-239) va el nombre del color.


void mostrarResultadoColor(uint16_t colorMuestra, const char *texto)
{
  // Banda superior: muestra del color, centrada y dentro del circulo
  gfx->fillRect(0, 0, 240, 60, COLOR_NEGRO);
  gfx->fillCircle(CENTRO_X, 34, 19, colorMuestra);
  gfx->drawCircle(CENTRO_X, 34, 21, COLOR_BLANCO);

  // Banda inferior: nombre del color y contador, centrados y ajustados al circulo
  gfx->fillRect(0, 180, 240, 60, COLOR_NEGRO);
  textoCentrado(texto, 186, 2, COLOR_BLANCO);

  char cuenta[24];
  snprintf(cuenta, sizeof(cuenta), "CAPTURAS: %lu", (unsigned long)totalCapturas);
  textoCentrado(cuenta, 208, 1, COLOR_BLANCO);
}


void testCameraSCCB()
{
  Serial.println("Probando comunicacion SCCB...");

  cameraI2C.start();

  bool ack = cameraI2C.writeByte(0x42);

  cameraI2C.stop();

  if (ack)
  {
    Serial.println("OV7670 responde por SCCB");
  }
  else
  {
    Serial.println("ERROR: OV7670 no responde por SCCB");
  }
}

void setup()
{
  Serial.begin(115200);
  delay(1000);

  Serial.println();
  Serial.println("CAZA COLORES - OV7670 + GC9A01 + TCS34725");
  Serial.println("ESP32 DevKit V1 / Core 3.3.12");

  Serial.println("Iniciando pantalla...");
  if (!gfx->begin()) {
    Serial.println("ERROR: no se pudo iniciar GC9A01.");
    while (true) delay(1000);
  }
  dibujarInicio();   // pantalla de inicio: se queda hasta pulsar JUEGO o ARCHIVO

  if (!cameraBegin()) {
    gfx->fillScreen(COLOR_ROJO);
    textoCentrado("ERROR CAM", 112, 2, COLOR_BLANCO);
    while (true) delay(1000);
  }

  sensorColorBegin();

  almacenamientoOK = LittleFS.begin(false);
  if (almacenamientoOK) {
    Serial.println("LittleFS OK.");
    cargarArchivo();
  } else {
    Serial.println("ERROR LittleFS: no se pudo montar. No se formateo la memoria.");
  }

  // GPIO3 se utiliza como boton, por eso se libera UART0 despues del arranque.
  Serial.println("Sistema listo. No mantener pulsados botones al encender.");
  Serial.end();

  for (uint8_t i = 0; i < 3; i++) {
    pinMode(botones[i].pin, INPUT_PULLUP);
    botones[i].lecturaAnterior = digitalRead(botones[i].pin);
    botones[i].estadoEstable = botones[i].lecturaAnterior;
    botones[i].cambio = millis();
  }

  // La pantalla de inicio ya esta dibujada desde el arranque; no se redibuja.
  pantallaActual = PANTALLA_INICIO;
}

// --------------------------------------------------
// LOOP PRINCIPAL
// --------------------------------------------------

void loop()
{
  procesarBotones();

  if (pantallaActual != PANTALLA_JUEGO) {
    delay(5);
    return;
  }

  if (sensorOK && millis() - ultimaLectura >= INTERVALO_COLOR) {
    ultimaLectura = millis();
    actualizarColor();
  }

  if (!cameraCaptureFrame()) {
    delay(10);
    return;
  }

  gfx->draw16bitRGBBitmap(
    40,
    60,
    (uint16_t *)cameraFrame,
    CAM_WIDTH,
    CAM_HEIGHT
  );

  dibujarMira();
}

// Arma la lista con los colores que tienen al menos una captura
void armarListaArchivo()
{
  totalListaArchivo = 0;
  for (uint8_t i = 0; i < TOTAL_COLORES; i++) {
    if (conteosColores[i] > 0) listaArchivo[totalListaArchivo++] = i;
  }
  seleccionArchivo = 0;
}

// Color con el que se escribe cada nombre cuando su fila esta activa (fondo blanco).
// Mismo orden que NOMBRES_COLORES. Son tonos algo mas profundos que los de la
// deteccion para que se lean bien sobre blanco; BLANCO usa negro porque blanco
// sobre blanco no se veria.
static_assert(TOTAL_COLORES == 11, "Actualizar colorDeFilaActiva() si cambia NOMBRES_COLORES");
uint16_t colorDeFilaActiva(uint8_t idx)
{
  const uint16_t tonos[TOTAL_COLORES] = {
    gfx->color565(  0,   0,   0),   // NEGRO
    gfx->color565(120, 120, 120),   // GRIS
    gfx->color565(  0,   0,   0),   // BLANCO (negro: sobre blanco no se veria)
    gfx->color565(230,   0,   0),   // ROJO
    gfx->color565(255,  70, 160),   // ROSADO
    gfx->color565(255, 115,   0),   // NARANJA
    gfx->color565(225, 175,   0),   // AMARILLO
    gfx->color565(  0, 165,   0),   // VERDE
    gfx->color565(  0, 165, 185),   // TURQUESA
    gfx->color565(  0,  60, 230),   // AZUL
    gfx->color565(130,   0, 200)    // MORADO
  };
  return tonos[idx];
}

void dibujarFilaArchivo(uint8_t fila, uint8_t posicionLista, bool seleccionada)
{
  uint8_t idx = listaArchivo[posicionLista];
  int y = ARCH_Y0 + fila * ARCH_PASO;
  int ancho = min(ARCH_ANCHO, anchoDisponible(y, y + ARCH_ALTO));
  int x = CENTRO_X - ancho / 2;

  // Fila activa: fondo blanco y letras del color correspondiente
  uint16_t colorTexto = seleccionada ? colorDeFilaActiva(idx) : COLOR_BLANCO;
  if (seleccionada) gfx->fillRoundRect(x, y, ancho, ARCH_ALTO, 8, COLOR_BLANCO);
  else              gfx->drawRoundRect(x, y, ancho, ARCH_ALTO, 8, COLOR_GRIS);

  const char *nombre = NOMBRES_COLORES[idx];
  char cuenta[12];
  snprintf(cuenta, sizeof(cuenta), "%lu", (unsigned long)conteosColores[idx]);

  // 36 px = 14 de margen interno a cada lado + 8 de separacion entre nombre y numero
  uint8_t tam = 2;
  while (tam > 1 && (int)((strlen(nombre) + strlen(cuenta)) * 6 * tam) + 36 > ancho) tam--;

  int yTexto = y + (ARCH_ALTO - 8 * tam) / 2;
  int anchoCuenta = (int)(strlen(cuenta) * 6 * tam) - tam;

  gfx->setTextSize(tam);
  gfx->setTextColor(colorTexto);
  gfx->setCursor(x + 14, yTexto);
  gfx->print(nombre);
  gfx->setCursor(x + ancho - 14 - anchoCuenta, yTexto);
  gfx->print(cuenta);
}

void dibujarArchivo()
{
  gfx->fillScreen(COLOR_NEGRO);
  textoCentrado("ARCHIVO", 28, 2, COLOR_CYAN);

  if (totalListaArchivo == 0) {
    textoCentrado("SIN CAPTURAS", 112, 2, COLOR_BLANCO);
    return;
  }

  // Ventana de 3 filas: la seleccion baja hasta la ultima fila y luego la lista se desplaza
  uint8_t inicio = 0;
  if (seleccionArchivo >= FILAS_ARCHIVO) inicio = seleccionArchivo - (FILAS_ARCHIVO - 1);

  for (uint8_t f = 0; f < FILAS_ARCHIVO; f++) {
    uint8_t pos = inicio + f;
    if (pos >= totalListaArchivo) break;
    dibujarFilaArchivo(f, pos, pos == seleccionArchivo);
  }
}

void entrarAlArchivo()
{
  pantallaActual = PANTALLA_ARCHIVO;
  armarListaArchivo();
  dibujarArchivo();
}

// Cada pulsacion de ARCHIVO baja un color; despues del ultimo vuelve al primero
void avanzarArchivo()
{
  if (totalListaArchivo == 0) return;
  seleccionArchivo = (seleccionArchivo + 1) % totalListaArchivo;
  dibujarArchivo();
}


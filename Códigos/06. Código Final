bool cameraConfigure()
{
  if (!clockEnable(CAM_XCLK, 20000000))
    return false;
  delay(200);

Serial.println("Probando SCCB con XCLK activo...");

cameraI2C.start();
bool ack = cameraI2C.writeByte(0x42);
cameraI2C.stop();

if (ack)
{
  Serial.println("OK: OV7670 responde por SCCB");
}
else
{
  Serial.println("ERROR: sin respuesta SCCB con XCLK activo");
  return false;
}

  pinMode(CAM_VSYNC, INPUT);

  uint32_t startTime = millis();

  while (!digitalRead(CAM_VSYNC))
  {
    if (millis() - startTime > 2000)
      return false;
  }

  while (digitalRead(CAM_VSYNC))
  {
    if (millis() - startTime > 2500)
      return false;
  }

  // Reinicio de registros de cámara
  Serial.println("Enviando reinicio a OV7670...");
   Serial.println("Resultado del reinicio SCCB");
  Serial.println("Probando escritura del registro COM7...");

cameraI2C.start();

bool ack1 = cameraI2C.writeByte(0x42);
cameraI2C.delayBit();

bool ack2 = cameraI2C.writeByte(0x12);
cameraI2C.delayBit();

bool ack3 = cameraI2C.writeByte(0x80);

cameraI2C.stop();

Serial.print("Respuesta direccion 0x42: ");
Serial.println(ack1 ? "OK" : "FALLO");

Serial.print("Respuesta registro 0x12: ");
Serial.println(ack2 ? "OK" : "FALLO");

Serial.print("Respuesta dato 0x80: ");
Serial.println(ack3 ? "OK" : "FALLO");

if (!ack1 || !ack2 || !ack3)
{
  Serial.println("ERROR: fallo en escritura SCCB");
  return false;
}

Serial.println("Reinicio de registros enviado.");
delay(100);

 // Formato RGB
cameraI2C.writeRegister(0x42, 0x12, 0x04);
cameraI2C.writeRegister(0x42, 0x40, 0xD0);

// Reloj y exposición
cameraI2C.writeRegister(0x42, 0x11, 0x80);
cameraI2C.writeRegister(0x42, 0x3B, 0x0A);

// Escalado QQVGA 160x120
cameraI2C.writeRegister(0x42, 0x0C, 0x04);
cameraI2C.writeRegister(0x42, 0x3E, 0x1A);
cameraI2C.writeRegister(0x42, 0x70, 0x3A);
cameraI2C.writeRegister(0x42, 0x71, 0x35);
cameraI2C.writeRegister(0x42, 0x72, 0x22);
cameraI2C.writeRegister(0x42, 0x73, 0xF2);
cameraI2C.writeRegister(0x42, 0xA2, 0x02);

  // Ventana de imagen
  cameraI2C.writeRegister(0x42, 0x17, 196 >> 3);
  cameraI2C.writeRegister(0x42, 0x18, 52 >> 3);
  cameraI2C.writeRegister(0x42, 0x32, ((52 & 7) << 3) | (196 & 7));

  cameraI2C.writeRegister(0x42, 0x19, 8 >> 2);
  cameraI2C.writeRegister(0x42, 0x1A, 488 >> 2);
  cameraI2C.writeRegister(0x42, 0x03, ((488 & 3) << 2) | (8 & 3));

  // Ajuste de color
cameraI2C.writeRegister(0x42, 0xB0, 0x84);
cameraI2C.writeRegister(0x42, 0x4F, 0x80);
cameraI2C.writeRegister(0x42, 0x50, 0x80);

int indiceColor(const char *nombre)
{
  for (uint8_t i = 0; i < TOTAL_COLORES; i++) {
    if (strcmp(nombre, NOMBRES_COLORES[i]) == 0) return i;
  }
  return -1;
}

void guardarArchivo()
{
  if (!almacenamientoOK) return;
  File f = LittleFS.open("/colores.txt", "w");
  if (!f) {
    Serial.println("ERROR al abrir /colores.txt para escribir.");
    return;
  }
  for (uint8_t i = 0; i < TOTAL_COLORES; i++) {
    f.print(NOMBRES_COLORES[i]);
    f.print(",");
    f.println(conteosColores[i]);
  }
  f.close();
}

void cargarArchivo()
{
  for (uint8_t i = 0; i < TOTAL_COLORES; i++) conteosColores[i] = 0;
  if (!almacenamientoOK) return;

  File f = LittleFS.open("/colores.txt", "r");
  if (!f) return;

  while (f.available()) {
    String linea = f.readStringUntil('\n');
    linea.trim();
    int coma = linea.indexOf(',');
    if (coma <= 0) continue;
    String nombre = linea.substring(0, coma);
    uint32_t cantidad = (uint32_t)linea.substring(coma + 1).toInt();
    int idx = indiceColor(nombre.c_str());
    if (idx >= 0) conteosColores[idx] = cantidad;
  }
  f.close();

  totalCapturas = 0;
  for (uint8_t i = 0; i < TOTAL_COLORES; i++) totalCapturas += conteosColores[i];
}


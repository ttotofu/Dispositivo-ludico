// --------------------------------------------------
// GEOMETRIA DE LA PANTALLA CIRCULAR (240x240, radio real = 120 px)
// --------------------------------------------------
// Todo debe quedar dentro de un circulo de radio RADIO_SEGURO (~10 px de margen
// contra el borde). anchoDisponible() entrega el ancho horizontal util entre dos
// alturas, y los helpers de texto reducen el tamano de letra si algo no cabe.
const int CENTRO_X = 120;
const int CENTRO_Y = 120;
const int RADIO_SEGURO = 110;

int anchoDisponible(int yArriba, int yAbajo)
{
  int dy = max(abs(yArriba - CENTRO_Y), abs(yAbajo - CENTRO_Y));
  if (dy >= RADIO_SEGURO) return 0;
  return 2 * (int)sqrtf((float)(RADIO_SEGURO * RADIO_SEGURO - dy * dy));
}

// Fuente base: 6 px de ancho y 8 px de alto por cada unidad de tamano.
uint8_t ajustarTamano(size_t letras, int yArriba, uint8_t tam)
{
  while (tam > 1 && (int)(letras * 6 * tam) > anchoDisponible(yArriba, yArriba + 8 * tam)) tam--;
  return tam;
}

void textoCentrado(const char *texto, int yArriba, uint8_t tam, uint16_t color)
{
  size_t n = strlen(texto);
  tam = ajustarTamano(n, yArriba, tam);
  int ancho = (int)(n * 6 * tam) - tam;

  gfx->setTextSize(tam);
  gfx->setTextColor(color);
  gfx->setCursor(CENTRO_X - ancho / 2, yArriba);
  gfx->print(texto);
}

// Texto centrado con cada letra de un color distinto (los espacios no cuentan).
// 'k' es el indice de color con el que parte; devuelve el siguiente para encadenar lineas.
uint8_t textoMulticolor(const char *texto, int yArriba, uint8_t tam, uint8_t k)
{
  const uint16_t paleta[8] = {
    gfx->color565(255,  70,  70),   // rojo
    gfx->color565(255, 150,   0),   // naranja
    gfx->color565(255, 230,   0),   // amarillo
    gfx->color565( 60, 220,  60),   // verde
    gfx->color565(  0, 220, 255),   // turquesa
    gfx->color565( 80, 120, 255),   // azul
    gfx->color565(180,  90, 255),   // morado
    gfx->color565(255,  90, 200)    // rosado
  };

  size_t n = strlen(texto);
  tam = ajustarTamano(n, yArriba, tam);
  int paso = 6 * tam;
  int x0 = CENTRO_X - ((int)(n * paso) - tam) / 2;

  gfx->setTextSize(tam);
  for (size_t i = 0; i < n; i++) {
    if (texto[i] == ' ') continue;
    gfx->setTextColor(paleta[k % 8]);
    gfx->setCursor(x0 + (int)i * paso, yArriba);
    gfx->print(texto[i]);
    k++;
  }
  return k;
}

// Escribe un texto largo en varias lineas centradas, cortando por palabras y
// respetando el ancho del circulo en cada altura. Devuelve la y donde termina.
// Con dibujar = false solo mide (sirve para elegir el tamano de letra).
int envolverTexto(const char *texto, int yInicio, uint8_t tam, int paso, uint16_t color, bool dibujar)
{
  char buf[160];
  strncpy(buf, texto, sizeof(buf) - 1);
  buf[sizeof(buf) - 1] = '\0';

  char *p = buf;
  int y = yInicio;

  while (*p) {
    while (*p == ' ') p++;
    if (!*p) break;

    int maxCh = anchoDisponible(y, y + 8 * tam) / (6 * tam);
    if (maxCh < 4) break;                       // ya no hay espacio en el circulo

    int largo = strlen(p);
    int corte = largo;
    if (largo > maxCh) {
      corte = maxCh;
      while (corte > 0 && p[corte] != ' ') corte--;
      if (corte == 0) corte = maxCh;            // palabra mas larga que la linea
    }

    if (dibujar) {
      char linea[40];
      int n = min(corte, 39);
      memcpy(linea, p, n);
      while (n > 0 && linea[n - 1] == ' ') n--;
      linea[n] = '\0';
      textoCentrado(linea, y, tam, color);
    }

    p += corte;
    y += paso;
  }
  return y;
}

// Texto largo en tamano 2; si no cabe antes de yMax, baja a tamano 1.
void textoLargo(const char *texto, int yInicio, int yMax, uint16_t color)
{
  uint8_t tam = 2;
  if (envolverTexto(texto, yInicio, 2, 19, color, false) > yMax) tam = 1;
  envolverTexto(texto, yInicio, tam, (tam == 2) ? 19 : 11, color, true);
}


// Elige una adivinanza al azar, distinta de la anterior
void elegirAdivinanza()
{
  uint8_t nueva;
  do {
    nueva = (uint8_t)(esp_random() % TOTAL_ADIVINANZAS);
  } while (TOTAL_ADIVINANZAS > 1 && nueva == adivinanzaActual);

  adivinanzaActual = nueva;
  adivinanzaColor = indiceColor(ADIVINANZAS[nueva].color);
}


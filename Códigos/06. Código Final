bool cameraBegin()
{
  Serial.println("Iniciando reloj XCLK...");

  if (!cameraConfigure())
  {
    Serial.println("ERROR: no se pudo iniciar la OV7670.");
    return false;
  }

  Serial.println("Configurando memoria de imagen...");

Serial.printf("RAM interna libre: %u bytes\n",
  heap_caps_get_free_size(MALLOC_CAP_INTERNAL | MALLOC_CAP_8BIT));

Serial.printf("Bloque contiguo mayor: %u bytes\n",
  heap_caps_get_largest_free_block(MALLOC_CAP_INTERNAL | MALLOC_CAP_8BIT));
  cameraFrame = (uint8_t *)heap_caps_malloc(
    frameBytes,
    MALLOC_CAP_INTERNAL | MALLOC_CAP_8BIT
  );

  if (!cameraFrame)
  {
    Serial.println("ERROR: no hay memoria para el fotograma.");
    return false;
  }

  if (!cameraI2SInit())
  {
    Serial.println("ERROR: inicialización I2S.");
    return false;
  }

  if (!cameraDMAInit())
  {
    Serial.println("ERROR: inicialización DMA.");
    return false;
  }

  gpio_set_intr_type(
    (gpio_num_t)CAM_VSYNC,
    GPIO_INTR_POSEDGE
  );

  gpio_intr_enable((gpio_num_t)CAM_VSYNC);

  if (gpio_isr_register(
        &cameraVSyncInterrupt,
        nullptr,
        ESP_INTR_FLAG_INTRDISABLED | ESP_INTR_FLAG_IRAM,
        &vsyncInterruptHandle) != ESP_OK)
  {
    Serial.println("ERROR: interrupción VSYNC.");
    return false;
  }

  if (esp_intr_alloc(
        ETS_I2S0_INTR_SOURCE,
        ESP_INTR_FLAG_INTRDISABLED |
        ESP_INTR_FLAG_LEVEL1 |
        ESP_INTR_FLAG_IRAM,
        &cameraI2SInterrupt,
        nullptr,
        &i2sInterruptHandle) != ESP_OK)
  {
    Serial.println("ERROR: interrupción I2S.");
    return false;
  }

  Serial.println("Cámara preparada.");
  return true;
}


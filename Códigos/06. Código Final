class CameraI2C
{
public:
  int sda;
  int scl;

  CameraI2C(int dataPin, int clockPin)
  {
    sda = dataPin;
    scl = clockPin;

    pinMode(sda, INPUT_PULLUP);
    pinMode(scl, INPUT_PULLUP);
  }

  void delayBit()
  {
    delayMicroseconds(2);
  }

  void sdaLow()
  {
    pinMode(sda, OUTPUT);
    digitalWrite(sda, LOW);
  }

  void sdaHigh()
  {
    pinMode(sda, INPUT_PULLUP);
  }

  void sclLow()
  {
    pinMode(scl, OUTPUT);
    digitalWrite(scl, LOW);
  }

  void sclHigh()
  {
    pinMode(scl, INPUT_PULLUP);
  }

  void start()
  {
    sdaHigh();
    sclHigh();
    delayBit();
    sdaLow();
    delayBit();
    sclLow();
  }

  void stop()
  {
    sdaLow();
    sclHigh();
    delayBit();
    sdaHigh();
    delayBit();
  }

  bool writeByte(uint8_t value)
  {
    for (int i = 0; i < 8; i++)
    {
      if (value & 0x80)
        sdaHigh();
      else
        sdaLow();

      value <<= 1;

      delayBit();
      sclHigh();
      delayBit();
      sclLow();
    }

    sdaHigh();
    delayBit();
    sclHigh();
    delayBit();

    bool ack = (digitalRead(sda) == LOW);

    sclLow();
    return ack;
  }

  bool writeRegister(uint8_t address, uint8_t reg, uint8_t value)
  {
    start();

    bool ok = writeByte(address);
    if (ok) ok = writeByte(reg);
    if (ok) ok = writeByte(value);

    stop();
    return ok;
  }
};

CameraI2C cameraI2C(CAM_SIOD, CAM_SIOC);


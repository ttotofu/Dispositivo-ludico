bool cameraBegin()
{
  Serial.println("Iniciando reloj XCLK...");

  if (!cameraConfigure())
  {
    Serial.println("ERROR: no se pudo iniciar la OV7670.");
    return false;
  }

  Serial.println("Configurando memoria de imagen...");

Serial.printf("RAM interna libre: %u bytes\n",
  heap_caps_get_free_size(MALLOC_CAP_INTERNAL | MALLOC_CAP_8BIT));

Serial.printf("Bloque contiguo mayor: %u bytes\n",
  heap_caps_get_largest_free_block(MALLOC_CAP_INTERNAL | MALLOC_CAP_8BIT));
  cameraFrame = (uint8_t *)heap_caps_malloc(
    frameBytes,
    MALLOC_CAP_INTERNAL | MALLOC_CAP_8BIT
  );

  if (!cameraFrame)
  {
    Serial.println("ERROR: no hay memoria para el fotograma.");
    return false;
  }

  if (!cameraI2SInit())
  {
    Serial.println("ERROR: inicialización I2S.");
    return false;
  }

  if (!cameraDMAInit())
  {
    Serial.println("ERROR: inicialización DMA.");
    return false;
  }

  gpio_set_intr_type(
    (gpio_num_t)CAM_VSYNC,
    GPIO_INTR_POSEDGE
  );

  gpio_intr_enable((gpio_num_t)CAM_VSYNC);

  if (gpio_isr_register(
        &cameraVSyncInterrupt,
        nullptr,
        ESP_INTR_FLAG_INTRDISABLED | ESP_INTR_FLAG_IRAM,
        &vsyncInterruptHandle) != ESP_OK)
  {
    Serial.println("ERROR: interrupción VSYNC.");
    return false;
  }

  if (esp_intr_alloc(
        ETS_I2S0_INTR_SOURCE,
        ESP_INTR_FLAG_INTRDISABLED |
        ESP_INTR_FLAG_LEVEL1 |
        ESP_INTR_FLAG_IRAM,
        &cameraI2SInterrupt,
        nullptr,
        &i2sInterruptHandle) != ESP_OK)
  {
    Serial.println("ERROR: interrupción I2S.");
    return false;
  }

  Serial.println("Cámara preparada.");
  return true;
}

// --------------------------------------------------
// SENSOR DE COLOR TCS34725
// --------------------------------------------------
// Pines I2C del sensor (distintos de los de la camara).
// Alternativa: compartir el bus SCCB de la camara con SENSOR_SDA 26 y SENSOR_SCL 27
// (el sensor tendria que ir soldado/conectado a esas mismas lineas).

#define SENSOR_SDA 4
#define SENSOR_SCL 15

Adafruit_TCS34725 tcs =
  Adafruit_TCS34725(
    TCS34725_INTEGRATIONTIME_50MS,
    TCS34725_GAIN_4X
  );

bool sensorOK = false;

unsigned long ultimaLectura = 0;

// Cada cuanto se lee el color (el codigo original del sensor usaba 5000 ms)
const unsigned long INTERVALO_COLOR = 1000;

#define COLOR_NEGRO  0x0000
#define COLOR_BLANCO 0xFFFF

// =====================================================
// FUNCIÓN: DETECTAR COLOR
// =====================================================

const char* detectarColor(
  int rojo,
  int verde,
  int azul
) {

  // ---------------------------------------------------
  // BUSCAR EL VALOR MÁXIMO Y MÍNIMO
  // ---------------------------------------------------

  int maximo = max(rojo, max(verde, azul));
  int minimo = min(rojo, min(verde, azul));

  int diferencia = maximo - minimo;


  // ---------------------------------------------------
  // BRILLO MUY BAJO
  // ---------------------------------------------------

  if (maximo < 25) {
    return "NEGRO";
  }


  // ---------------------------------------------------
  // GRIS
  // ---------------------------------------------------

  // Si los tres canales son parecidos
  if (diferencia < 25) {

    if (maximo < 80) {
      return "GRIS";
    }

    return "BLANCO";
  }


  // ---------------------------------------------------
  // BLANCO
  // ---------------------------------------------------

  if (minimo > 170 &&
      diferencia < 70) {

    return "BLANCO";
  }


  // ---------------------------------------------------
  // CALCULAR TONO HUE
  // ---------------------------------------------------

  float h = 0;

  if (diferencia == 0) {

    h = 0;

  } else if (maximo == rojo) {

    h = 60.0 * (
      (float)(verde - azul) / diferencia
    );

    if (h < 0) {
      h += 360;
    }

  } else if (maximo == verde) {

    h = 60.0 * (
      (float)(azul - rojo) / diferencia
    ) + 120;

  } else {

    h = 60.0 * (
      (float)(rojo - verde) / diferencia
    ) + 240;
  }


  // ---------------------------------------------------
  // SATURACIÓN
  // ---------------------------------------------------

  float saturacion =
    (float)diferencia / maximo;


  // ---------------------------------------------------
  // POCO COLOR
  // ---------------------------------------------------

  if (saturacion < 0.18) {

    if (maximo < 100) {
      return "GRIS";
    }

    return "BLANCO";
  }


  // ===================================================
  // CLASIFICACIÓN
  // ===================================================

  // ---------------------------------------------------
  // ROJO
  // 0° aproximadamente
  // ---------------------------------------------------

  if (h >= 345 || h < 10) {
    return "ROJO";
  }


  // ---------------------------------------------------
  // ROSADO
  // ---------------------------------------------------

  if (h >= 330 && h < 345) {

    if (rojo > 120) {
      return "ROSADO";
    }

    return "ROJO";
  }


  // ---------------------------------------------------
  // NARANJA
  // ---------------------------------------------------

  if (h >= 10 && h < 45) {
    return "NARANJA";
  }


  // ---------------------------------------------------
  // AMARILLO
  // ---------------------------------------------------

  if (h >= 45 && h < 75) {
    return "AMARILLO";
  }


  // ---------------------------------------------------
  // VERDE
  // ---------------------------------------------------

  if (h >= 75 && h < 165) {
    return "VERDE";
  }


  // ---------------------------------------------------
  // TURQUESA
  // ---------------------------------------------------

  if (h >= 165 && h < 195) {
    return "TURQUESA";
  }


  // ---------------------------------------------------
  // AZUL
  // ---------------------------------------------------

  if (h >= 195 && h < 255) {
    return "AZUL";
  }


  // ---------------------------------------------------
  // MORADO
  // ---------------------------------------------------

  if (h >= 255 && h < 300) {
    return "MORADO";
  }


  // ---------------------------------------------------
  // ROSADO / MAGENTA
  // ---------------------------------------------------

  if (h >= 300 && h < 345) {
    return "ROSADO";
  }


  // ---------------------------------------------------
  // SEGURIDAD
  // ---------------------------------------------------

  return "COLOR";
}


// --------------------------------------------------
// MOSTRAR RESULTADO EN LAS BANDAS LIBRES DE LA PANTALLA
// --------------------------------------------------
// El video ocupa y = 60 a 179. Arriba (y 0-59) va la muestra de color
// y abajo (y 180-239) va el nombre del color.

void mostrarResultadoColor(uint16_t colorMuestra, const char *texto)
{
  gfx->fillRect(0, 0, 240, 60, COLOR_NEGRO);
  gfx->fillCircle(120, 30, 22, colorMuestra);
  gfx->drawCircle(120, 30, 24, COLOR_BLANCO);

  gfx->fillRect(0, 180, 240, 60, COLOR_NEGRO);
  gfx->setTextSize(3);
  gfx->setTextColor(COLOR_BLANCO);

  int ancho = strlen(texto) * 18;
  int x = (240 - ancho) / 2;

  if (x < 5)
    x = 5;

  gfx->setCursor(x, 186);
  gfx->print(texto);
}

// Mira en el centro de la imagen: marca la zona que mide el sensor
void dibujarMira()
{
  gfx->drawCircle(120, 120, 14, COLOR_BLANCO);
  gfx->drawFastHLine(100, 120, 10, COLOR_BLANCO);
  gfx->drawFastHLine(130, 120, 10, COLOR_BLANCO);
  gfx->drawFastVLine(120, 100, 10, COLOR_BLANCO);
  gfx->drawFastVLine(120, 130, 10, COLOR_BLANCO);
}

// --------------------------------------------------
// LEER SENSOR, DETECTAR Y MOSTRAR COLOR
// --------------------------------------------------

void actualizarColor()
{
  uint16_t r;
  uint16_t g;
  uint16_t b;
  uint16_t c;

  tcs.getRawData(&r, &g, &b, &c);

  Serial.println();
  Serial.println("------------------------------");
  Serial.printf("R: %u  G: %u  B: %u  C: %u\n", r, g, b, c);

  if (c == 0)
  {
    Serial.println("SIN LUZ");
    mostrarResultadoColor(COLOR_NEGRO, "SIN LUZ");
    return;
  }

  // Normalizar RGB (0-255) usando la luz total como referencia
  int rojo  = constrain((r * 255L) / c, 0, 255);
  int verde = constrain((g * 255L) / c, 0, 255);
  int azul  = constrain((b * 255L) / c, 0, 255);

  const char *nombre = detectarColor(rojo, verde, azul);

  Serial.printf("RGB normalizado: %d, %d, %d\n", rojo, verde, azul);
  Serial.print("COLOR DETECTADO: ");
  Serial.println(nombre);

  mostrarResultadoColor(gfx->color565(rojo, verde, azul), nombre);
}

// Se inicia DESPUES de la camara: la camara configura sus pines por software
// y el sensor usa el I2C por hardware en otros pines.
void sensorColorBegin()
{
  Wire.begin(SENSOR_SDA, SENSOR_SCL);

  if (tcs.begin())
  {
    sensorOK = true;
    Serial.println("TCS34725 OK.");
  }
  else
  {
    sensorOK = false;
    Serial.println("ERROR: TCS34725 NO detectado. El video seguira funcionando.");
    mostrarResultadoColor(COLOR_NEGRO, "SIN SENSOR");
  }
}

// --------------------------------------------------
// SETUP
// --------------------------------------------------

void testCameraSCCB()
{
  Serial.println("Probando comunicacion SCCB...");

  cameraI2C.start();

  bool ack = cameraI2C.writeByte(0x42);

  cameraI2C.stop();

  if (ack)
  {
    Serial.println("OV7670 responde por SCCB");
  }
  else
  {
    Serial.println("ERROR: OV7670 no responde por SCCB");
  }
}

void setup()
{
  Serial.begin(115200);
  delay(1000);

  Serial.println();
  Serial.println("OV7670 + GC9A01");
  Serial.println("ESP32 DevKit V1 / Core 3.3.12");

  Serial.println("Iniciando pantalla...");

  if (!gfx->begin())
  {
    Serial.println("ERROR: no se pudo iniciar GC9A01.");
    while (true) delay(1000);
  }

  gfx->fillScreen(0x0000);
  gfx->setTextColor(0xFFFF);
  gfx->setCursor(45, 105);
  gfx->setTextSize(2);
  gfx->println("CAMERA");

  Serial.println("Pantalla iniciada.");

  if (!cameraBegin())
  {
    gfx->fillScreen(0xF800);
    gfx->setCursor(35, 110);
    gfx->setTextColor(0xFFFF);
    gfx->println("ERROR CAM");
    while (true) delay(1000);
  }

  gfx->fillScreen(0x0000);

  sensorColorBegin();

  Serial.println("Sistema listo.");
}

// --------------------------------------------------
// LOOP: VIDEO EN DIRECTO + COLOR
// --------------------------------------------------

void loop()
{
  // Lectura periodica del color
  if (sensorOK && millis() - ultimaLectura >= INTERVALO_COLOR)
  {
    ultimaLectura = millis();
    actualizarColor();
  }

  if (!cameraCaptureFrame())
  {
    Serial.println("No se pudo capturar fotograma.");
    delay(20);
    return;
  }

  gfx->draw16bitRGBBitmap(
    40,
    60,
    (uint16_t *)cameraFrame,
    CAM_WIDTH,
    CAM_HEIGHT
  );

  dibujarMira();
}

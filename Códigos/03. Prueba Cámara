bool cameraI2SInit()
{
  int pins[] =
  {
    CAM_VSYNC,
    CAM_HREF,
    CAM_PCLK,
    CAM_D0,
    CAM_D1,
    CAM_D2,
    CAM_D3,
    CAM_D4,
    CAM_D5,
    CAM_D6,
    CAM_D7
  };

  gpio_config_t conf = {};
  conf.mode = GPIO_MODE_INPUT;
  conf.pull_up_en = GPIO_PULLUP_DISABLE;
  conf.pull_down_en = GPIO_PULLDOWN_DISABLE;
  conf.intr_type = GPIO_INTR_DISABLE;

  for (int i = 0; i < 11; i++)
  {
    conf.pin_bit_mask = 1ULL << pins[i];

    if (gpio_config(&conf) != ESP_OK)
      return false;
  }

  gpio_matrix_in(CAM_D0, I2S0I_DATA_IN0_IDX, false);
  gpio_matrix_in(CAM_D1, I2S0I_DATA_IN1_IDX, false);
  gpio_matrix_in(CAM_D2, I2S0I_DATA_IN2_IDX, false);
  gpio_matrix_in(CAM_D3, I2S0I_DATA_IN3_IDX, false);
  gpio_matrix_in(CAM_D4, I2S0I_DATA_IN4_IDX, false);
  gpio_matrix_in(CAM_D5, I2S0I_DATA_IN5_IDX, false);
  gpio_matrix_in(CAM_D6, I2S0I_DATA_IN6_IDX, false);
  gpio_matrix_in(CAM_D7, I2S0I_DATA_IN7_IDX, false);

  gpio_matrix_in(0x30, I2S0I_DATA_IN8_IDX, false);
  gpio_matrix_in(0x30, I2S0I_DATA_IN9_IDX, false);
  gpio_matrix_in(0x30, I2S0I_DATA_IN10_IDX, false);
  gpio_matrix_in(0x30, I2S0I_DATA_IN11_IDX, false);
  gpio_matrix_in(0x30, I2S0I_DATA_IN12_IDX, false);
  gpio_matrix_in(0x30, I2S0I_DATA_IN13_IDX, false);
  gpio_matrix_in(0x30, I2S0I_DATA_IN14_IDX, false);
  gpio_matrix_in(0x30, I2S0I_DATA_IN15_IDX, false);

  gpio_matrix_in(CAM_VSYNC, I2S0I_V_SYNC_IDX, true);
  gpio_matrix_in(0x38, I2S0I_H_SYNC_IDX, false);
  gpio_matrix_in(CAM_HREF, I2S0I_H_ENABLE_IDX, false);
  gpio_matrix_in(CAM_PCLK, I2S0I_WS_IN_IDX, false);

  periph_module_enable(PERIPH_I2S0_MODULE);

  i2sReset();

  I2S0.conf.rx_slave_mod = 1;
  I2S0.conf2.lcd_en = 1;
  I2S0.conf2.camera_en = 1;

  I2S0.clkm_conf.clkm_div_a = 1;
  I2S0.clkm_conf.clkm_div_b = 0;
  I2S0.clkm_conf.clkm_div_num = 2;

  I2S0.fifo_conf.dscr_en = 1;
I2S0.fifo_conf.rx_fifo_mod = 1;

  I2S0.fifo_conf.rx_fifo_mod_force_en = 1;
  I2S0.conf_chan.rx_chan_mod = 1;

  I2S0.sample_rate_conf.rx_bits_mod = 0;
  I2S0.conf.rx_right_first = 0;
  I2S0.conf.rx_msb_right = 0;
  I2S0.conf.rx_msb_shift = 0;
  I2S0.conf.rx_mono = 0;
  I2S0.conf.rx_short_sync = 0;
  I2S0.timing.val = 0;

  return true;
}

// --------------------------------------------------
// INICIALIZACIÓN DMA
// --------------------------------------------------

bool cameraDMAInit()
{
  const int dmaBytes = CAM_WIDTH * 4;

  for (int i = 0; i < 2; i++)
  {
    dmaBuffers[i] = new CameraDMABuffer(dmaBytes);

    if (!dmaBuffers[i]->buffer)
      return false;
  }

  dmaBuffers[0]->next(dmaBuffers[1]);
  dmaBuffers[1]->next(dmaBuffers[0]);

  return true;
}

// --------------------------------------------------
// ARRANQUE DE CAPTURA
// --------------------------------------------------

bool cameraCaptureStart()
{
  uint32_t startTime = millis();

  Serial.print("VSYNC inicial: ");
  Serial.println(digitalRead(CAM_VSYNC));

  while (digitalRead(CAM_VSYNC) == LOW)
  {
    if (millis() - startTime > 1000)
    {
      Serial.println("ERROR: VSYNC nunca subio a HIGH");
      return false;
    }
  }

  Serial.println("VSYNC paso a HIGH");

  while (digitalRead(CAM_VSYNC) == HIGH)
  {
    if (millis() - startTime > 1500)
    {
      Serial.println("ERROR: VSYNC nunca volvio a LOW");
      return false;
    }
  }

  Serial.println("VSYNC paso a LOW");

  esp_intr_disable(i2sInterruptHandle);

  i2sReset();

  blocksReceived = 0;
  dmaActive = 0;
  framePointer = 0;
  frameComplete = false;
  stopRequested = true;

  I2S0.rx_eof_num = dmaBuffers[0]->descriptor.length / 4;

  I2S0.in_link.addr =
    (uint32_t)&dmaBuffers[0]->descriptor;

  I2S0.in_link.start = 1;

  I2S0.int_clr.val = I2S0.int_raw.val;
  I2S0.int_ena.val = 0;
  I2S0.int_ena.in_done = 1;

  esp_intr_enable(i2sInterruptHandle);
  esp_intr_enable(vsyncInterruptHandle);

  I2S0.conf.rx_start = 1;

  Serial.println("I2S iniciado; esperando captura...");
  return true;
}

// --------------------------------------------------
// CAPTURA DE UN FOTOGRAMA
// --------------------------------------------------

bool cameraCaptureFrame()
{
  if (!cameraCaptureStart())
    return false;

  uint32_t startTime = millis();

  while (stopRequested)
  {
    if (millis() - startTime > 1500)
    {
      Serial.println("ERROR: tiempo agotado esperando captura");
Serial.print("Bloques recibidos: ");
Serial.println(blocksReceived);
Serial.print("Bytes recibidos: ");
Serial.println(framePointer);
Serial.print("VSYNC actual: ");
Serial.println(digitalRead(CAM_VSYNC));
Serial.print("I2S int_raw: ");
Serial.println(I2S0.int_raw.val, HEX);
      esp_intr_disable(i2sInterruptHandle);
      esp_intr_disable(vsyncInterruptHandle);

      I2S0.conf.rx_start = 0;
      stopRequested = false;

      return false;
    }

    delay(1);
  }

  return frameComplete;
}


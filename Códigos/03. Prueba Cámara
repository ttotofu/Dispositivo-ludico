bool clockEnable(int pin, uint32_t hz)
{
  if (!ledcAttach(pin, hz, 1))
    return false;

  return ledcWrite(pin, 1);
}

// --------------------------------------------------
// I2C POR SOFTWARE PARA OV7670
// --------------------------------------------------

class CameraI2C
{
public:
  int sda;
  int scl;

  CameraI2C(int dataPin, int clockPin)
  {
    sda = dataPin;
    scl = clockPin;

    pinMode(sda, INPUT_PULLUP);
    pinMode(scl, INPUT_PULLUP);
  }

  void delayBit()
  {
    delayMicroseconds(2);
  }

  void sdaLow()
  {
    pinMode(sda, OUTPUT);
    digitalWrite(sda, LOW);
  }

  void sdaHigh()
  {
    pinMode(sda, INPUT_PULLUP);
  }

  void sclLow()
  {
    pinMode(scl, OUTPUT);
    digitalWrite(scl, LOW);
  }

  void sclHigh()
  {
    pinMode(scl, INPUT_PULLUP);
  }

  void start()
  {
    sdaHigh();
    sclHigh();
    delayBit();
    sdaLow();
    delayBit();
    sclLow();
  }

  void stop()
  {
    sdaLow();
    sclHigh();
    delayBit();
    sdaHigh();
    delayBit();
  }

  bool writeByte(uint8_t value)
  {
    for (int i = 0; i < 8; i++)
    {
      if (value & 0x80)
        sdaHigh();
      else
        sdaLow();

      value <<= 1;

      delayBit();
      sclHigh();
      delayBit();
      sclLow();
    }

    sdaHigh();
    delayBit();
    sclHigh();
    delayBit();

    bool ack = (digitalRead(sda) == LOW);

    sclLow();
    return ack;
  }

  bool writeRegister(uint8_t address, uint8_t reg, uint8_t value)
  {
    start();

    bool ok = writeByte(address);
    if (ok) ok = writeByte(reg);
    if (ok) ok = writeByte(value);

    stop();
    return ok;
  }
};

CameraI2C cameraI2C(CAM_SIOD, CAM_SIOC);

// --------------------------------------------------
// DMA
// --------------------------------------------------

struct CameraDMABuffer
{
  lldesc_t descriptor;
  uint8_t *buffer;

  CameraDMABuffer(int bytes)
  {
    buffer = (uint8_t *)heap_caps_malloc(
      bytes,
      MALLOC_CAP_DMA | MALLOC_CAP_INTERNAL
    );

    memset(&descriptor, 0, sizeof(descriptor));

    descriptor.length = bytes;
    descriptor.size = bytes;
    descriptor.owner = 1;
    descriptor.sosf = 1;
    descriptor.buf = buffer;
    descriptor.offset = 0;
    descriptor.eof = 1;
    descriptor.qe.stqe_next = nullptr;
  }

  void next(CameraDMABuffer *other)
  {
    descriptor.qe.stqe_next = &other->descriptor;
  }
};

CameraDMABuffer *dmaBuffers[2] = {nullptr, nullptr};

volatile int dmaActive = 0;
volatile int blocksReceived = 0;

uint8_t *cameraFrame = nullptr;

volatile int framePointer = 0;
int frameBytes = CAM_WIDTH * CAM_HEIGHT * 2;

volatile bool stopRequested = false;
volatile bool frameComplete = false;

intr_handle_t i2sInterruptHandle = nullptr;
intr_handle_t vsyncInterruptHandle = nullptr;

// --------------------------------------------------
// REINICIO DE I2S
// --------------------------------------------------

void i2sReset()
{
  const uint32_t lcFlags =
    I2S_IN_RST_M |
    I2S_AHBM_RST_M |
    I2S_AHBM_FIFO_RST_M;

  I2S0.lc_conf.val |= lcFlags;
  I2S0.lc_conf.val &= ~lcFlags;

  const uint32_t confFlags =
    I2S_RX_RESET_M |
    I2S_RX_FIFO_RESET_M |
    I2S_TX_RESET_M |
    I2S_TX_FIFO_RESET_M;

  I2S0.conf.val |= confFlags;
  I2S0.conf.val &= ~confFlags;

  while (I2S0.state.rx_fifo_reset_back) {}
}

// --------------------------------------------------
// INTERRUPCIÓN I2S
// --------------------------------------------------

void IRAM_ATTR cameraI2SInterrupt(void *arg)
{
  I2S0.int_clr.val = I2S0.int_raw.val;

  blocksReceived++;

  uint8_t *buf = dmaBuffers[dmaActive]->buffer;

  dmaActive = (dmaActive + 1) % 2;

  if (framePointer < frameBytes)
  {
    for (int i = 0; i < CAM_WIDTH * 4; i += 4)
    {
      cameraFrame[framePointer++] = buf[i + 2];
      cameraFrame[framePointer++] = buf[i];
    }
  }

  if (blocksReceived >= CAM_HEIGHT)
  {
    framePointer = 0;
    blocksReceived = 0;

    frameComplete = true;

    if (stopRequested)
    {
      esp_intr_disable(i2sInterruptHandle);
      esp_intr_disable(vsyncInterruptHandle);

      I2S0.conf.rx_start = 0;
      stopRequested = false;
    }
  }
}

// --------------------------------------------------
// INTERRUPCIÓN VSYNC
// --------------------------------------------------

void IRAM_ATTR cameraVSyncInterrupt(void *arg)
{
  GPIO.status_w1tc = (1U << CAM_VSYNC);
}

